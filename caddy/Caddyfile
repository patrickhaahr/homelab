immich.haahr.me {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }

    # Immich needs large body sizes for photo/video uploads
    request_body {
        max_size 0
    }

    reverse_proxy immich_server:2283

    log {
        output file /var/log/caddy/immich.log
        format json
    }
}

