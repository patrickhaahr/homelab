{
    email caddy@haahr.me
}

openhome.haahr.me {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	resolvers 1.1.1.1
    }
    
    reverse_proxy openhome-api:8000

    log {
        output file /var/log/caddy/openhome.log
        format json
    }
}

